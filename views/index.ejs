<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>OmniBlog — Share Your Story</title>
    <style>
        :root {
            --bg-main: #0f111a;
            --panel-bg: rgba(26, 29, 46, 0.6);
            --border-line: rgba(255, 255, 255, 0.06);
            --accent-gold: #e2ba43;
            --text-main: #f1f3f9;
            --text-secondary: #9aa0b1;
        }
        body { background: var(--bg-main); color: var(--text-main); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 0; padding: 0; }
        .blog-container { max-width: 800px; margin: 50px auto; padding: 0 20px; }
        .hero-section { text-align: center; margin-bottom: 50px; }
        .hero-section h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 10px; }
        .hero-section h1 span { color: var(--accent-gold); }
        .hero-section p { color: var(--text-secondary); font-size: 1.1rem; }
        .post-card { background: var(--panel-bg); border: 1px solid var(--border-line); border-radius: 12px; padding: 35px; margin-bottom: 30px; backdrop-filter: blur(8px); }
        .post-title { font-size: 1.6rem; font-weight: 600; margin-top: 0; margin-bottom: 8px; color: var(--text-main); }
        .post-meta { font-size: 0.85rem; color: var(--accent-gold); margin-bottom: 20px; font-weight: 500; }
        .post-content { line-height: 1.7; color: #d1d5db; font-size: 1.05rem; }
    </style>
</head>
<body>

    <%- navbar %>

    <div class="blog-container">
        <div class="hero-section">
            <h1>Welcome to <span>OmniBlog</span></h1>
            <p>Publish your passions, your way. Create a unique and beautiful blog today.</p>
        </div>

        <h2 style="font-size: 1.2rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-secondary); margin-bottom: 25px; border-bottom: 1px solid var(--border-line); padding-bottom: 10px;">Recent Stories From Our Community</h2>

        <% posts.forEach(post => { %>
            <div class="post-card">
                <div class="post-title"><%= post.title %></div>
                <div class="post-meta">Published by <%= post.author %></div>
                <div class="post-content"><%= post.content %></div>
            </div>
        <% }) %>
    </div>

</body>
</html>