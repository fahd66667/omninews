<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OmniNews // Global Editorial</title>
  <style>
    :root {
      --bg-main: #0a0a0c;
      --gold: #d4af37;
      --gold-dim: #aa8c2c;
      --tactical-orange: #ff5500;
      --glass-bg: rgba(26, 26, 30, 0.45);
      --glass-border: rgba(212, 175, 55, 0.15);
      --text-main: #f0f0f3;
      --text-muted: #8a8a93;
    }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: 'Segoe UI', system-ui, sans-serif;
      margin: 0;
      padding: 0;
      line-height: 1.6;
    }

    header {
      border-bottom: 1px solid var(--glass-border);
      background: rgba(10, 10, 12, 0.8);
      backdrop-filter: blur(12px);
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .nav-container {
      max-width: 1100px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.2rem 2rem;
    }

    .logo {
      font-weight: 800;
      letter-spacing: 2px;
      font-size: 1.5rem;
      text-transform: uppercase;
      color: var(--text-main);
    }
    .logo span { color: var(--gold); }

    .btn-compose {
      background: linear-gradient(135deg, var(--gold), var(--gold-dim));
      color: #000;
      padding: 0.6rem 1.5rem;
      text-decoration: none;
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.8rem;
      letter-spacing: 1px;
      border-radius: 4px;
      box-shadow: 0 4px 15px rgba(212, 175, 55, 0.2);
      transition: all 0.3s ease;
    }

    .btn-compose:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
    }

    main {
      max-width: 800px;
      margin: 3rem auto;
      padding: 0 2rem;
    }

    .feed-header {
      border-left: 3px solid var(--tactical-orange);
      padding-left: 1rem;
      margin-bottom: 3rem;
    }

    .feed-header h2 {
      font-size: 2rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin: 0;
    }

    .post-card {
      background: var(--glass-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--glass-border);
      padding: 2.5rem;
      border-radius: 12px;
      margin-bottom: 2rem;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
      transition: border 0.3s ease;
    }

    .post-card:hover {
      border-solid: 1px;
      border-color: rgba(212, 175, 55, 0.4);
    }

    .post-card h3 {
      font-size: 1.7rem;
      margin-top: 0;
      margin-bottom: 0.5rem;
      color: var(--text-main);
    }

    .post-meta {
      font-size: 0.8rem;
      color: var(--gold);
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 1.5rem;
      display: flex;
      gap: 10px;
    }

    .post-meta .tag {
      color: var(--tactical-orange);
      font-weight: bold;
    }

    .post-content {
      color: #d1d1d6;
      white-space: pre-wrap;
    }

    .no-posts {
      text-align: center;
      padding: 4rem 2rem;
      background: var(--glass-bg);
      border-radius: 12px;
      border: 1px dashed var(--glass-border);
      color: var(--text-muted);
    }
  </style>
</head>
<body>

  <header>
    <div class="nav-container">
      <div class="logo">OMNI<span>NEWS</span></div>
      <a href="/compose" class="btn-compose">+ Publish Story</a>
    </div>
  </header>

  <main>
    <div class="feed-header">
      <h2>Global Wire</h2>
    </div>

    <% if (posts.length === 0) { %>
      <div class="no-posts">
        <p>No articles on the wire yet. Be the first to broadcast dispatch.</p>
      </div>
    <% } else { %>
      <% posts.forEach(post => { %>
        <article class="post-card">
          <div class="post-meta">
            <span class="tag">// BROADCAST</span>
            <span><%= new Date(post.createdAt).toDateString() %></span>
          </div>
          <h3><%= post.title %></h3>
          <p class="post-content"><%= post.content %></p>
        </article>
      <% }); %>
    <% } %>
  </main>

</body>
</html>